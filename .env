# Mock 模式：默认关闭，访问时加 ?mock 参数启用（方便本地调试）
VITE_MOCK_DEFAULT=false

# wo-bot-web 用户中心地址（自定义授权流程入口 /app-new-bind）
# 默认指向生产环境，本地开发可改为 http://localhost:9094
VITE_AUTH_WEB_URL=https://user.wo-bot.com

# 设备管理 API 地址（wo-bot-device-api，自定义 OAuth 端点 /api/oauth/*）
# 默认指向生产环境，本地开发可改为 http://localhost:3000
VITE_API_BASE=https://api.wo-bot.com

# 应用标识（用于授权页面展示和授权码生成）
# wo-bot-web-debug 作为 wo-bot-account 中的个人授权应用
VITE_APP_ID=wo-bot-web-debug

# 信令服务器地址（云端远控 WebSocket + WebRTC 信令）
VITE_SIGNAL_URL=https://signal.wo-bot.com
